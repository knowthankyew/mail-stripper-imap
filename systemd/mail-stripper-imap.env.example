# MailStripper IMAP Watcher Configuration
# Copy to /etc/mail-stripper-imap/env and restrict permissions:
#   sudo install -m 600 -o mailstripper -g mailstripper mail-stripper-imap.env.example /etc/mail-stripper-imap/env

# IMAP Connection Settings
IMAP__HOST=imap.example.com
IMAP__PORT=993
IMAP__USE_SSL=true
IMAP__USERNAME=user@example.com
IMAP__PASSWORD=your-secure-password-here

# Mailbox Folder Hierarchy
IMAP__MONITORED_FOLDER=@Safe-Unsubscribe
IMAP__ARCHIVE_FOLDER=@Safe-Unsubscribe/Archive
IMAP__QUARANTINE_FOLDER=@Safe-Unsubscribe/Quarantine
IMAP__AUDIT_FOLDER=@Safe-Unsubscribe/Audit

# Forensic Ingestion Plane Integration
IMAP__MAIL_STRIPPER_URL=http://localhost:5001
IMAP__TRUSTED_AUTHSERV_ID=

# Opt-Out Execution (Default: false dry-run / tag-only)
IMAP__AUTO_EXECUTE_STERILE_UNSUBSCRIBE=false

# Health Monitoring Endpoint
IMAP__HEALTH_CHECK_ENABLED=true
IMAP__HEALTH_CHECK_PORT=8080
IMAP__HEALTH_CHECK_HOST=127.0.0.1
